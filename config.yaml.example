# Parking Cockpit Configuration
# All paths are relative to the project root or absolute

app:
  host: "127.0.0.1"
  port: 8000
  debug: false

logging:
  level: "INFO"
  file: "parking_cockpit.log"
  max_bytes: 10485760  # 10MB
  backup_count: 5

timezone: "Europe/Berlin"

polling:
  interval_minutes: 5
  enabled: true

storage:
  database: "parking_cockpit.db"
  raw_mails_folder: "raw_mails"
  retention_days: 365
  raw_mails_permissions: "0700"

ui:
  upcoming_days: 7
  current_window_grace_minutes: 0
  auto_refresh_seconds: 60
  items_per_page: 25

mailbox:
  seen_flags: ["\\Seen"]
  archive_processed: true
